# ─── Social Studio ─────────────────────────────────────────────────────────
# Where posts are scheduled: Creative Tim Social Studio (connected channels,
# Content Calendar, copilot/autopilot setting). A key with the social:draft
# scope, from creative-tim.com/dashboard/api-keys or a CompanyFabric key on a
# linked account. Add social:publish only if your account runs in autopilot.
SOCIAL_API_KEY=
SOCIAL_API_URL=https://www.creative-tim.com/ui/api/social/tools
# true: without a key, use a sample studio (fictional channels, in memory).
# The scripted DEMO always uses it.
DEMO_DATA=false
# A password for the whole app (HTTP Basic, any username, 12+ characters).
# Set it whenever the app is reachable from anywhere but your own machine:
# with a key set, whoever opens the app can approve posts to your channels.
APP_PASSWORD=

# ─── Model ─────────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat.completions endpoint. With no key, the app runs a
# scripted DEMO so you can see the flow.
#
# CompanyFabric (default): one key for every model, pay per token, sk-cf-...
#   https://companyfabric.com/dashboard/keys
OPENAI_BASE_URL=https://api.companyfabric.com/v1
OPENAI_API_KEY=
MODEL=companyfabric/auto
#
# OpenAI directly:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   MODEL=gpt-5.5
# A local server (Ollama, LM Studio, vLLM): its /v1 URL and a model it serves
# that supports tool calling.

# ─── Search ────────────────────────────────────────────────────────────────
# parallel works with no key (free, rate-limited); a key lifts the limits.
# exa needs EXA_API_KEY. companyfabric is not released yet.
SEARCH_PROVIDER=parallel
PARALLEL_API_KEY=
EXA_API_KEY=
COMPANYFABRIC_SEARCH_ENABLED=false

# ─── Runtime ───────────────────────────────────────────────────────────────
# lite: the loop runs in this app (pnpm dev, or any Node host incl. Vercel).
# hermes: the turn runs in a Hermes Agent container (docker compose up).
# Left empty: hermes when HERMES_URL is set, lite otherwise.
RUNTIME=
# Hermes (docker-compose.yml sets HERMES_URL for you).
HERMES_URL=
# Generate with: openssl rand -hex 32
HERMES_API_KEY=
# Lets Hermes call this app's tools at /api/mcp. Generate with: openssl rand -hex 32
TOOL_TOKEN=

# Where the SQLite database lives.
DATA_DIR=./data
