{
  "name": "@agent-starters/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI of the agent starters: an Apple-style theme on shadcn/ui primitives, chat components adapted from AI Elements, and the agent app shell (threads, conversation, approvals, inspector panels).",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./lib/*": "./src/lib/*.ts",
    "./agent/turns": "./src/agent/turns.ts",
    "./agent/use-agent-chat": "./src/agent/use-agent-chat.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-starters/kit": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
